# Collected data — ~1 GB of per-city poll logs and Blitzortung ground truth.
# Regenerated by running the collector; must never enter git history, where
# it cannot be removed without rewriting every commit that follows.
weather_benchmark/data/

# Generated analysis output (weekly backtests run to tens of MB).
# To keep a specific report anyway: git add -f weather_benchmark/reports/<file>
weather_benchmark/reports/

# Collector logs (collector.log rotates to .1-.5; collector.out.log to .1)
weather_benchmark/*.log
weather_benchmark/*.log.[0-9]*

# Vendored wgrib2 binaries
wgrib/

# Local machine config (collector paths, tokens). config.example.yaml is the
# tracked template.
weather_benchmark/config.yaml

# Python bytecode and test caches
__pycache__/
*.py[cod]
.pytest_cache/
